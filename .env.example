# Copy to .env and fill in. .env is gitignored; this file must never hold a key.
#
# The server reads these from the ENVIRONMENT, not from a file — it has no
# dotenv dependency and does not want one. Export them in the shell that starts
# uvicorn, or have your shell source this after filling it in.
#
# Verified working 2026-09-23. Any OpenAI-compatible chat-completions endpoint
# works; the adapter targets the shape, not the vendor (DECISIONS.md 195).

SHIELD_MODEL_ENDPOINT=https://generativelanguage.googleapis.com/v1beta/openai/chat/completions
SHIELD_MODEL_NAME=gemini-3.5-flash-lite
SHIELD_MODEL_KEY=

# 5s, not the 12s default. Measured latency is 1.5-1.7s, so this is ~3x the
# worst observed call and still falls back to the rule path fast enough that a
# dead network looks like a pause rather than a freeze. See DECISIONS.md 270.
SHIELD_MODEL_TIMEOUT=5

# Attach the redacted frame. On by default; set to 0 only to force text-only.
SHIELD_MODEL_VISION=1
